# ─────────────────────────────────────────────────────────────
# .dockerignore — files excluded from the Docker build context
# This keeps the image small and avoids copying sensitive files
# ─────────────────────────────────────────────────────────────

# Version control
.git
.gitignore

# Docker files themselves (no need to copy into the image)
Dockerfile
docker-compose.yml
docker/
.dockerignore

# Documentation
README.md
*.md

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp
*.temp
